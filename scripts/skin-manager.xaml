<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 换肤管理中心" Width="1180" Height="860" MinWidth="960" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#151617" Foreground="#EDEDF0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedBrush" Color="#9899A3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2B2C30"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EDEDF0"/>
      <Setter Property="BorderBrush" Value="#2B2C30"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#EDEDF0"/><Setter Property="Foreground" Value="#202126"/>
      <Setter Property="BorderBrush" Value="#EDEDF0"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#9899A3"/>
      <Setter Property="Padding" Value="0,7"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9899A3"/><Setter Property="Padding" Value="1,12,1,13"/>
      <Setter Property="Margin" Value="0,0,26,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="TileBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="Transparent">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#AFA2C8"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileBorder" Property="Background" Value="#1D1E21"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="32,25,32,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="我的壁纸" FontSize="25" FontWeight="Medium"/><TextBlock Text="收藏喜欢的画面，随时换一种心情。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
      <Button x:Name="ImportButton" Grid.Column="1" Content="＋  导入壁纸" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AllFilter" Content="全部" Style="{StaticResource FilterButton}" BorderBrush="#EDEDF0" Foreground="#EDEDF0"/>
          <Button x:Name="ImageFilter" Content="静态" Style="{StaticResource FilterButton}"/>
          <Button x:Name="VideoFilter" Content="动态" Style="{StaticResource FilterButton}"/>
        </StackPanel>
        <TextBlock x:Name="LibrarySummary" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <StackPanel>
        <Grid Margin="0,0,0,26">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <Border x:Name="GalleryPreview" Height="340" Background="#101113" CornerRadius="9" ClipToBounds="True">
            <Grid><TextBlock x:Name="PreviewPlaceholder" Text="选择一张壁纸" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap"/><Image x:Name="PreviewImage" Stretch="Uniform"/><MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="Uniform" Visibility="Collapsed"/></Grid>
          </Border>
          <StackPanel x:Name="GalleryDetails" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="SelectedStatus" Text="SELECTED WALLPAPER" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,9"/>
            <TextBlock x:Name="SelectedName" Text="尚未选择壁纸" FontSize="29" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
            <TextBlock x:Name="SelectedDetails" Text="从下方选择壁纸，或导入新的图片与视频。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ApplyButton" Content="应用壁纸  ↗" Style="{StaticResource PrimaryButton}"/><Button x:Name="PlayButton" Grid.Column="2" Content="播放预览" Visibility="Collapsed"/></Grid>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <Grid TextElement.FontSize="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/></Grid.RowDefinitions>
                <TextBlock Text="类型" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedFormat" Grid.Column="1" Text="—" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="文件大小" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedSize" Grid.Row="1" Grid.Column="1" Text="—" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Text="导入时间" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedImportedAt" Grid.Row="2" Grid.Column="1" Text="—" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button x:Name="RenameButton" Content="重命名" Style="{StaticResource TextButton}" Margin="0,0,25,0"/><Button x:Name="DeleteButton" Content="删除" Style="{StaticResource TextButton}"/></StackPanel>
            <TextBlock x:Name="PreviewNotice" Foreground="#B7A88F" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" MaxHeight="34"/>
          </StackPanel>
        </Grid>
        <Grid MinHeight="182">
          <ListBox x:Name="WallpaperList" MaxHeight="230" VerticalAlignment="Top" Background="Transparent" Foreground="#EDEDF0" BorderThickness="0" Padding="1,3,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel Width="220">
                <Border CornerRadius="6" Background="#101113" ClipToBounds="True"><Grid Height="124"><TextBlock Text="{Binding Placeholder}" Foreground="#7E8089" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/></Grid></Border>
                <Grid Margin="1,10,1,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="12" Margin="0,0,7,0"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}"><Ellipse Width="4" Height="4" Fill="#7AA991" Margin="0,0,4,0"/><TextBlock Text="正在使用" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                </Grid>
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,1,2"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,20"><TextBlock x:Name="EmptyTitle" Text="你的壁纸收藏，从这里开始" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="点击右上角导入图片或视频，保存后随时切换。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,15,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="WorkProgress" Height="2" Visibility="Collapsed" IsIndeterminate="True" Foreground="#AFA2C8" Background="#2B2C30" Margin="0,0,0,9"/>
        <Grid Grid.Row="3" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource TextButton}"/></Grid>
        <Border x:Name="UpdateBanner" Grid.Row="4" Visibility="Collapsed" Background="#24222B" CornerRadius="6" Padding="12" Margin="0,8,0,0">
          <StackPanel><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" FontSize="12"/></ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="InstallUpdateButton" Content="立即更新" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0"/><Button x:Name="LaterUpdateButton" Content="稍后" Style="{StaticResource TextButton}" Margin="0,0,20,0"/><Button x:Name="SkipUpdateButton" Content="跳过此版本" Style="{StaticResource TextButton}"/></StackPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionText" Text="正在检测本机 Codex…" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><Button x:Name="DetectButton" Grid.Column="1" Content="重新检测" Style="{StaticResource TextButton}"/></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="正在加载壁纸库…" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="44" Margin="0,0,20,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SaveCurrentButton" Content="保存当前背景" Style="{StaticResource TextButton}" Margin="0,0,23,0"/><Button x:Name="OpenButton" Content="打开 Codex  ↗" Style="{StaticResource TextButton}" Margin="0,0,23,0"/><Button x:Name="RestoreButton" Content="恢复原始外观" Style="{StaticResource TextButton}"/></StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
